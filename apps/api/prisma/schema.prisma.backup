generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  VERIFIER
}

enum NeedStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  ACTIVE
  RESOLVED
  REJECTED
}

enum NeedUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ResponseType {
  PRAYER
  VOLUNTEER
  MATERIAL
  FINANCIAL
  PARTNERSHIP
}

enum ResponseStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  passwordHash String?
  role         UserRole      @default(USER)

  organization Organization?

  prayers   Prayer[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?
  location    String?
  website     String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  needs     Need[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Need {
  id          String      @id @default(uuid())
  title       String
  description String
  location    String
  community   String?
  status      NeedStatus  @default(DRAFT)
  urgency     NeedUrgency @default(MEDIUM)
  verified    Boolean     @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  prayers   Prayer[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([urgency])
  @@index([location])
  @@index([organizationId])
}

model Prayer {
  id String @id @default(uuid())

  message String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  needId String
  need   Need   @relation(fields: [needId], references: [id])

  createdAt DateTime @default(now())

  @@index([needId])
  @@index([userId])
}

model Response {
  id String @id @default(uuid())

  type    ResponseType
  message String?
  status  ResponseStatus @default(SUBMITTED)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  needId String
  need   Need   @relation(fields: [needId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([needId])
  @@index([userId])
  @@index([status])
}