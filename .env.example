# Public API URL used by the Next.js application
NEXT_PUBLIC_API_URL="http://localhost:3003"

# NestJS API port
PORT=3003

# Replace this placeholder with a long, random secret for local development
JWT_SECRET="replace-this-with-a-long-random-secret"
